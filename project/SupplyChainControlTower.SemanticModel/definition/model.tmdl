annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table DimDate
ref table DimProduct
ref table DimWarehouse
ref table DimSupplier
ref table DimCustomer
ref table FactSalesOrders
ref table FactPurchaseOrders
ref table FactInventoryMonthly
ref table _Measures
