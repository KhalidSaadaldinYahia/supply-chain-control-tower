					Typed = Table.TransformColumnTypes(Headers, {{"DateKey", Int64.Type}, {"SnapshotDate", type date}, {"ProductKey", Int64.Type}, {"WarehouseKey", Int64.Type}, {"OnHandUnits", Int64.Type}, {"Demand28D", type number}, {"SafetyStockUnits", type number}, {"DaysOfSupply", type number}, {"InventoryValue", type number}, {"ExcessInventoryValue", type number}, {"ShortageUnits", type number}, {"StockoutRiskFlag", Int64.Type}})
